cc_binary {
    name: "android.hardware.lights-service.odessa",
    relative_install_path: "hw",
    init_rc: ["aidl/android.hardware.lights.odessa.rc"],
    vintf_fragments: ["aidl/android.hardware.lights.odessa.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "liblog",
        "libhardware",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
    srcs: [
        "aidl/Lights.cpp",
        "aidl/main.cpp",
    ],
}